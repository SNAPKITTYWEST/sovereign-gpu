// Matrix multiplication example
a = [1, 2, 3, 4] // 2x2 matrix: [1 2; 3 4]
b = [5, 6, 7, 8] // 2x2 matrix: [5 6; 7 8]
c = reshape(a, [2, 2])
d = reshape(b, [2, 2])
e = c */ d // Matrix multiplication
